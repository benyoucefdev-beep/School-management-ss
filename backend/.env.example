# Supabase: use the TRANSACTION pooler (port 6543) in production. Session mode
# (5432) caps you at pool_size 15 total, which a serverless deployment exhausts
# quickly because each warm instance holds its own pool.
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/school_management

# Connections PER INSTANCE. Defaults: 2 on Vercel, 10 locally. Raise only if
# your database ceiling divided by your peak instance count allows it.
PG_POOL_MAX=
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
PORT=4000
NODE_ENV=development
UPLOAD_DIR=./uploads

# School name (used in notifications and emails)
SCHOOL_NAME=EduManage

# Team workload threshold (default: 10 open tasks per member)
WORKLOAD_THRESHOLD=10

# SMTP configuration for weekly digest email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
DIGEST_FROM_EMAIL=digest@edumanage.app

# ── Student Portal PWA ──────────────────────────────────────────
CLIENT_PWA_URL=https://students.edumanage.app
CLIENT_JWT_SECRET=generate_a_random_64_char_string_for_students

# ── Teacher Portal PWA ─────────────────────────────────────────
SUPPLIER_PWA_URL=https://teachers.edumanage.app
SUPPLIER_JWT_SECRET=generate_a_random_64_char_string_for_teachers

# Web Push Notifications (Run `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_MAILTO=mailto:admin@edumanage.app
