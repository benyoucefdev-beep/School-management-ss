{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/notifications/daily-cron",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/api/digest/weekly-cron",
      "dest": "backend/src/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend/src/index.js"
    },

    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/frontend/icons/$1"
    },
    {
      "src": "/(manifest\\.webmanifest|sw\\.js|favicon\\.ico|apple-touch-icon\\.png)",
      "dest": "/frontend/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/daily-cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/digest/weekly-cron",
      "schedule": "0 8 * * 1"
    }
  ]
}